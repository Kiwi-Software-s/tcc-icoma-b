# Local (opcional): o projeto possui uma chave de desenvolvimento se esta
# variável não estiver definida. Em produção, ela é obrigatória.
FLASK_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
FLASK_DEBUG=1

# Em produção (Render), coloque aqui o JSON INTEIRO da service account.
# Localmente, continue usando serviceAccountKey.json na raiz do projeto.
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
